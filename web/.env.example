# =============================================
# PICKLERS — Environment Variables Template
# =============================================
# Copy this to .env.local and fill in your keys.
# NEVER commit .env.local with real secrets.
# In production, set these in Vercel → Settings → Environment Variables.
# =============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://dpybdmzapznkdmqdsavq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PayMongo (Payments)
PAYMONGO_TEST_SECRET_KEY=sk_test_xxx
PAYMONGO_TEST_PUBLIC_KEY=pk_test_xxx
PAYMONGO_LIVE_SECRET_KEY=sk_live_xxx
PAYMONGO_LIVE_PUBLIC_KEY=pk_live_xxx
PAYMONGO_WEBHOOK_SECRET=wh_xxx

# Maps Platform
NEXT_PUBLIC_MAPS_API_KEY=your-google-maps-key

# Google API
NEXT_PUBLIC_GOOGLE_API_KEY=your-google-api-key

# Supabase Auth Callback
SUPABASE_AUTH_CALLBACK_URL=https://your-project.supabase.co/auth/v1/callback
NEXT_PUBLIC_SUPABASE_AUTH_CALLBACK_URL=https://your-project.supabase.co/auth/v1/callback

# Meta App Secret (only if using Facebook OAuth)
META_APP_SECRET=your-meta-app-secret

# Twilio Recovery Code (only if using phone OTP)
TWILIO_RECOVERY_CODE=your-twilio-recovery-code

# Resend (transactional email)
RESEND_API_KEY=re_xxx

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_xxx

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# OpenRouter / AI Chat
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# Deployed app URL (set on Vercel — REQUIRED for production)
NEXT_PUBLIC_SITE_URL=https://picklers.vercel.app

# Environment
NODE_ENV=development